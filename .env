# ─── MySQL (local) ──────────────────────────────────────────────────────────
RDB_HOST=mysql
RDB_USER=iteso_user
RDB_PASSWORD=iteso_password
RDB_NAME=iteso_db
RDB_PORT=3306

# ─── MongoDB (local) ─────────────────────────────────────────────────────────
MONGO_URI=mongodb://root:rootpassword@mongodb:27017/iteso_nube?authSource=admin

# ─── MinIO — reemplaza AWS S3 (API idéntica) ─────────────────────────────────
MINIO_ENDPOINT=http://minio:9000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_BUCKET_NAME=iteso-archivos

# ─── Keycloak — reemplaza Google OAuth ───────────────────────────────────────
# OIDC issuer de Keycloak (realm "iteso")
KEYCLOAK_ISSUER=http://keycloak:8080/realms/iteso
KEYCLOAK_CLIENT_ID=iteso-backend
KEYCLOAK_CLIENT_SECRET=iteso-secret-local

# Estos se usan en google.config.ts — apuntan al endpoint OIDC de Keycloak
GOOGLE_CLIENT_ID=iteso-backend
GOOGLE_CLIENT_SECRET=iteso-secret-local
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ─── JWT (firmado por el backend, igual que antes) ───────────────────────────
JWT_SECRET=local_super_secret_jwt_key_cambia_en_produccion

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
